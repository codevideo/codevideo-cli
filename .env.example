OPERATING_SYSTEM=linux
ENVIRONMENT=development

# TTS provider. Default is elevenlabs. Use kokoro with local codevideo-tts.
CODEVIDEO_TTS_PROVIDER=elevenlabs
TTS_SERVICE_URL=http://localhost:3000
TTS_API_KEY=

ELEVEN_LABS_API_KEY=
ELEVEN_LABS_VOICE_ID=
ELEVEN_LABS_VOICE_ID_CHRIS=
# Optional model, e.g. eleven_v4 (acts out audio tags like [whispers]), eleven_v3,
# eleven_flash_v2_5. Empty keeps the voice's usual model (eleven_multilingual_v2).
ELEVEN_LABS_MODEL_ID=

CODEVIDEO_S3_KEY_ID=
CODEVIDEO_S3_SECRET=

MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=

CLERK_SECRET_KEY=
CLERK_SECRET_KEY_STAGING=

# Slack notifications are optional. SLACK_WEBHOOK_URL is preferred.
SLACK_WEBHOOK_URL=
CODEVIDEO_SLACK_WEBHOOK_URL=

# Optional runtime tuning.
CODEVIDEO_CHROME_PATH=
CODEVIDEO_MAX_CONCURRENT_JOBS=2
# Experimental opt-in. Manifest renderMode takes precedence over this default.
CODEVIDEO_RENDER_MODE=realtime
# Required for deterministic speech (otherwise discovered next to FFmpeg/on PATH).
CODEVIDEO_FFPROBE_PATH=
